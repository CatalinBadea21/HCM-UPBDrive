   1:src/can_comm.c **** /*
   2:src/can_comm.c **** * File:        can_comm.c
   3:src/can_comm.c **** * Description: Handles CAN communication between the main controller and external subsystems,
   4:src/can_comm.c **** *              such as the ECU and ESC. Includes transmission of control commands and
   5:src/can_comm.c **** *              reception of vehicle status data over the CAN bus. Also defines the CAN ISR.
   6:src/can_comm.c **** */
   7:src/can_comm.c **** 
