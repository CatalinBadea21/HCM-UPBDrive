  20:src/can_comm.c **** /*
  21:src/can_comm.c ****  * Function:    CAN_Transmit_To_ESC
  22:src/can_comm.c ****  * Description: Sends a control command to the ESC (Electronic Speed Controller) over CAN.
  23:src/can_comm.c ****  * Parameters:
  24:src/can_comm.c ****  *   - driving_mode: Desired driving mode (e.g., normal, sport, reverse).
  25:src/can_comm.c ****  *   - duty_cycle: Signed 8-bit duty cycle value to be mapped and transmitted (throttle/power).
  26:src/can_comm.c ****  * Notes:
  27:src/can_comm.c ****  *   - The duty cycle is converted to a 15-bit value using Map_Duty_Cycle().
  28:src/can_comm.c ****  *   - Data is packed into CAN transmit buffer and sent via ESC control mailbox.
  29:src/can_comm.c ****  */
